{
  // 一個 Worker 同時負責：網頁（dist/）、API（/api/*）、每 30 分鐘的自動檢查
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "life-dashboard",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // 所有請求都先經過 Worker 檢查登入，沒登入拿不到任何檔案
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "life-dashboard",
      "database_id": "35248f86-ef86-4db1-a708-dfdb77070fb2"
    }
  ],
  "triggers": { "crons": ["*/30 * * * *"] },
  // 寫在通知信裡的控制台網址（不是機密）
  "vars": { "SITE_URL": "https://life-dashboard.alanwu14832.workers.dev" },
  "observability": { "enabled": true }
}
